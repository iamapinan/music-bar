<?xml version="1.0" encoding="utf-8"?>
<!-- Premium artwork container with subtle border glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow ring -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glow_violet" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <!-- Inner fill -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#1C2140" />
            <stroke
                android:width="1dp"
                android:color="#33406F" />
            <corners android:radius="30dp" />
        </shape>
    </item>
</layer-list>
