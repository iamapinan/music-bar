<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <ScrollView
        android:id="@+id/stationSelectView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="20dp"
        android:paddingVertical="28dp">

        <LinearLayout
            android:id="@+id/stationContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_station_hero"
                android:elevation="14dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingVertical="24dp">

                <View
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:alpha="0.95"
                    android:background="@drawable/bg_control_primary" />

                <TextView
                    android:id="@+id/stationSelectTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    android:letterSpacing="0.05"
                    android:text="Music Bar"
                    android:textColor="@color/white"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stationSelectSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:text="เลือกสถานีเพื่อเริ่มเล่นเพลง"
                    android:textColor="@color/slate_300"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stationList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_horizontal"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="200dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/playerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_control_secondary"
                    android:contentDescription="Back"
                    android:padding="12dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_skip_previous" />

                <TextView
                    android:id="@+id/stationLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/statusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:text="พร้อมเล่น"
                    android:textColor="#D7D5FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/artworkFrame"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/artworkView"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:contentDescription="Album artwork"
                    android:src="@drawable/ic_music_note" />
            </FrameLayout>

            <TextView
                android:id="@+id/queueTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Playlist"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/queueList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_control_bar"
        android:elevation="22dp"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/controlArtworkView"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_control_artwork"
                android:contentDescription="Current song artwork"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/playbackProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_musicbar" />

                <TextView
                    android:id="@+id/songTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:freezesText="true"
                    android:gravity="start"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="เลือกสถานี"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/songArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Music Bar"
                    android:textColor="@color/slate_300"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/currentTimeLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0:00"
                        android:textColor="#8E96BD"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/durationLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="0:00"
                        android:textColor="#8E96BD"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/previousButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_control_secondary"
                android:contentDescription="Previous"
                android:padding="13dp"
                android:scaleType="center"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginHorizontal="18dp"
                android:background="@drawable/bg_control_primary"
                android:contentDescription="Play"
                android:elevation="10dp"
                android:outlineProvider="bounds"
                android:padding="18dp"
                android:scaleType="center"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_control_secondary"
                android:contentDescription="Next"
                android:padding="13dp"
                android:scaleType="center"
                android:src="@drawable/ic_skip_next" />

            <TextView
                android:id="@+id/crossfadeToggle"
                android:layout_width="64dp"
                android:layout_height="38dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:text="CF ON"
                android:textColor="#D7D5FF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/crossfadeLabel"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:text=""
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
